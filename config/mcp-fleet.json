      "displayName": "CalculiX",
      "role": "Finite-element analysis: static, modal, buckling, creep and coupled thermal",
      "serviceName": "mcp-calculix",
      "transport": "streamable-http",
      "mcpUrl": "http://127.0.0.1:3015/mcp",
      "healthUrl": "http://127.0.0.1:3015/health",
      "image": "ghcr.io/casys-ai/mcp-calculix@sha256:76c9630eeecfe164c6b3c4d8b845c51fa7f8b48528773cb149b6c7a0ae2799a8",
      "required": true,
      "expectedTools": [
        "calculix_solve_static",
        "calculix_solve_modal",
        "calculix_solve_buckling",
        "calculix_solve_creep",
        "calculix_solve_coupled_thermal",
        "calculix_solve_static_recorded",
        "calculix_run_get"
