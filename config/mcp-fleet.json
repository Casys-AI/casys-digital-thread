      "trust": {
        "level": "first-party-local-privileged",
        "executesArbitraryCode": true,
        "notes": [
          "Runs geometry programs proposed by an agent and signed by a human after visual review.",
          "Private export volume: its output never reaches the shared evidence volume.",
          "The server lifts bytes out with docker compose cp and fail-closed SHA-256 verification."
        ]
      }
