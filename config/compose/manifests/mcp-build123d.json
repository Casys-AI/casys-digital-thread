{
  "name": "mcp-build123d",
  "description": "Local build123d CAD results and viewer.",
  "transport": {
    "type": "http",
    "url": "http://127.0.0.1:3014",
    "protocol": "stateless-2026-07-28"
  },
  "tools": [
    {
      "name": "build123d_execute",
      "description": "Execute trusted-local build123d Python and return geometry evidence.",
      "resourceUri": "ui://mcp-build123d/results-viewer",
      "inputSchema": {
        "type": "object",
        "properties": {
          "script": {
            "type": "string"
          },
          "density_kg_m3": {
            "type": "number"
          },
          "timeout_ms": {
            "type": "number",
            "description": "Execution time limit in milliseconds (default 60000)"
          }
        },
        "required": [
          "script"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "build123d_export",
      "description": "Export a previous build123d geometry result.",
      "resourceUri": "ui://mcp-build123d/results-viewer",
      "inputSchema": {
        "type": "object",
        "properties": {
          "script": {
            "type": "string"
          },
          "formats": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "step",
                "stl",
                "gltf"
              ]
            },
            "minItems": 1
          },
          "name": {
            "type": "string"
          },
          "density_kg_m3": {
            "type": "number"
          },
          "timeout_ms": {
            "type": "number",
            "description": "Execution time limit in milliseconds (default 60000)"
          }
        },
        "required": [
          "script",
          "formats",
          "name"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "build123d_export_read",
      "description": "App-only helper that reads one bounded GLB export by safe basename for the interactive viewer.",
      "appCallable": true,
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 5,
            "maxLength": 255,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*\\.glb$",
            "description": "Safe GLB basename returned in build123d_export.files[].viewer.name"
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      }
    }
  ]
}
