{
  "name": "mcp-erpnext-components",
  "description": "Read-only ERPNext presentation MCP exposing atomic BOM components.",
  "transport": {
    "type": "http",
    "url": "http://127.0.0.1:3017",
    "protocol": "stateless-2026-07-28"
  },
  "tools": [
    {
      "name": "erpnext_bom_surface",
      "description": "Load one ERPNext BOM as identity, metrics, materials, operations and cost components.",
      "resourceUri": "ui://mcp-erpnext-components/bom-surface",
      "emits": [
        "erpnext.bom.selected",
        "erpnext.material.selected"
      ],
      "accepts": [
        "syson.element.selected"
      ],
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "item": { "type": "string", "minLength": 1 },
          "is_active": { "type": "boolean" },
          "is_default": { "type": "boolean" },
          "limit": { "type": "number", "minimum": 1, "maximum": 50 }
        },
        "additionalProperties": false
      }
    }
  ]
}
