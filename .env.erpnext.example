# Copy this file to an ignored local file and replace the placeholders.
# Docker Compose overrides this URL with ERPNEXT_UPSTREAM_URL so the MCP uses
# container DNS instead of routing credentials through the host-published port.
ERPNEXT_URL=http://frontend:8080
ERPNEXT_API_KEY=replace-with-erpnext-api-key
ERPNEXT_API_SECRET=replace-with-erpnext-api-secret
